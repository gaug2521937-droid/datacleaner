# ============================================================
#  DataCleaner — пример конфигурации. Скопируйте в .env
#      cp .env.example .env
#  и заполните своими значениями. В .env НЕ должно быть ключей
#  в git: файл уже в .gitignore.
# ============================================================

# --- Шифрование персональных данных (обязательно для сервера) ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: потеря ключа = потеря доступа к сохранённым данным.
DATA_KEY=

# --- Режим отправки писем ---
# 1 = письма НЕ уходят (по умолчанию), 0 = реальная отправка через SMTP
DRY_RUN=1

# --- Почта, способ 1 (самый простой): вход через Google ---
# Пользователь нажимает «Войти через Google» и вводит свой ОБЫЧНЫЙ пароль на
# странице Google — пароли приложений не нужны. Письма идут через Gmail API по
# HTTPS (443), поэтому это работает и на бесплатном Render, где SMTP закрыт.
# Один раз создайте OAuth-клиент (Web application) в console.cloud.google.com:
#   APIs & Services → Library → Gmail API → Enable
#   OAuth consent screen → External → Test users: ваш адрес, scope gmail.send
#   Credentials → OAuth client ID → Web application
#   Authorized redirect URI: <ваш домен>/api/mail/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Необязательно: внешний адрес сервиса, если за прокси считается неверно
# (тогда redirect URI будет PUBLIC_BASE_URL + /api/mail/google/callback)
PUBLIC_BASE_URL=
# Альтернатива без интерактивного входа: refresh-токен, полученный заранее
GOOGLE_REFRESH_TOKEN=

# --- Почта, способ 2: HTTPS-API провайдера (нужно только для DRY_RUN=0) ---
#
# 1) HTTPS-API провайдера — единственный рабочий путь на бесплатном Render:
#    он блокирует исходящий SMTP на портах 25/465/587 (официальное ограничение).
#    Brevo: 300 писем в день бесплатно, адрес отправителя подтверждается один раз.
#       BREVO_API_KEY=xkeysib-...
#       EMAIL_FROM=you@example.com
#    Resend: без своего домена отправляет только на адрес владельца аккаунта.
#       RESEND_API_KEY=re_...
#       EMAIL_FROM=you@example.com
#    Достаточно ключа и EMAIL_FROM — транспорт выберется сам.
#    Принудительно: MAIL_PROVIDER=brevo | resend | smtp
MAIL_PROVIDER=
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=DataCleaner
#
# 2) SMTP — работает на своём ПК, VPS и на платных тарифах Render.
#    На бесплатном Render вместо 465/587 используйте порт 2525 (Brevo/SendGrid).
# --- SMTP ---
# Gmail: smtp.gmail.com:587 + «пароль приложения» (не пароль аккаунта)
# Яндекс: smtp.yandex.ru:465 (SMTP_SSL=1) + пароль приложения
# Mail.ru: smtp.mail.ru:465 (SMTP_SSL=1) + пароль приложения
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=DataCleaner
SMTP_SSL=0
SMTP_STARTTLS=1

# --- AI-помощник (OpenAI-совместимый API) ---
# Пример для tokenlavka: Base URL берётся из документации провайдера,
# обычно он заканчивается на /v1. Модель — точный ID из таблицы провайдера.
LLM_API_KEY=
LLM_BASE_URL=https://tokenlavka.com/v1
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT=60
LLM_MAX_TOKENS=800

# --- Путь к базе (нужно на хостингах с постоянным диском) ---
# Например: DATACLEANER_DB=/home/user/datacleaner.db
DATACLEANER_DB=

# --- Прочее ---
# Разрешённые origin для браузерных запросов (через запятую), * — все
CORS_ORIGINS=*
LOG_LEVEL=INFO
