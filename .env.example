# ============================================================
#  DataCleaner — пример конфигурации. Скопируйте в .env
#      cp .env.example .env
#  и заполните своими значениями. В .env НЕ должно быть ключей
#  в git: файл уже в .gitignore.
# ============================================================

# --- Шифрование персональных данных (обязательно для сервера) ---
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВНИМАНИЕ: потеря ключа = потеря доступа к сохранённым данным.
DATA_KEY=

# --- Режим отправки писем ---
# 1 = письма НЕ уходят (по умолчанию), 0 = реальная отправка через SMTP
DRY_RUN=1

# --- SMTP (нужно только для DRY_RUN=0) ---
# Gmail: smtp.gmail.com:587 + «пароль приложения» (не пароль аккаунта)
# Яндекс: smtp.yandex.ru:465 (SMTP_SSL=1) + пароль приложения
# Mail.ru: smtp.mail.ru:465 (SMTP_SSL=1) + пароль приложения
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=DataCleaner
SMTP_SSL=0
SMTP_STARTTLS=1

# --- AI-помощник (OpenAI-совместимый API) ---
# Пример для tokenlavka: Base URL берётся из документации провайдера,
# обычно он заканчивается на /v1. Модель — точный ID из таблицы провайдера.
LLM_API_KEY=
LLM_BASE_URL=https://tokenlavka.com/v1
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT=60
LLM_MAX_TOKENS=800

# --- Путь к базе (нужно на хостингах с постоянным диском) ---
# Например: DATACLEANER_DB=/home/user/datacleaner.db
DATACLEANER_DB=

# --- Прочее ---
# Разрешённые origin для браузерных запросов (через запятую), * — все
CORS_ORIGINS=*
LOG_LEVEL=INFO
